# 复制为 .env.prod 后填写【必填】项（.env.prod 勿提交 Git）
# cp .env.example .env.prod

# =============================================================================
# 【必填】RDS MySQL（内网地址，控制台 → 数据库连接）
# =============================================================================
MYSQL_RDS_HOST=
MYSQL_RDS_PORT=3306
MYSQL_DATABASE=xiaozhi_esp32_server
MYSQL_RDS_USER=
MYSQL_RDS_PASSWORD=

# =============================================================================
# 【必填】云 Redis（内网地址）
# =============================================================================
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# 【必填】对外访问（家长端 avatarUrl 等；HTTPS 时写 https://域名/xiaozhi）
# =============================================================================
XIAOZHI_PARENT_PUBLIC_BASE_URL=

# =============================================================================
# 教研 teaching-research internal 发布（与 teaching-research/deploy/prod 的 TEACHING_INTERNAL_API_KEY 相同）
# 注意：不要写 TEACHING_INTERNAL_API_KEY= 空行，会覆盖默认值导致校验失败；要么删掉该行，要么填与教研相同的一串
# TEACHING_INTERNAL_API_KEY=请与教研 .env.prod 填同一串

# =============================================================================
# 端口与绑定地址（edge-nginx 反代时使用 127.0.0.1，不对公网暴露）
# 临时调试可设 WEB_BIND=0.0.0.0；生产保持 127.0.0.1
# =============================================================================
WEB_BIND=127.0.0.1
WEB_PORT=8002
SERVER_BIND=127.0.0.1
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003

# 教研 teaching-research 对外 Nginx（在 ~/prjs/teaching-research/deploy/prod/docker-compose.yml 中改 ports，见 teaching.docker-compose.prod.example.yml）
# TEACHING_BIND=127.0.0.1
# TEACHING_PORT=8100

# =============================================================================
# 【必填】ACR 镜像（先在 deploy/prod/images 构建 push，再填此处；勿 docker compose --build）
# =============================================================================
WEB_IMAGE=crpi-q9r33h1cqhy6qssk.cn-beijing.personal.cr.aliyuncs.com/zhiban_agent/xiaozhi-web:v1.0.0
SERVER_IMAGE=crpi-q9r33h1cqhy6qssk.cn-beijing.personal.cr.aliyuncs.com/zhiban_agent/xiaozhi-server:v1.0.0

# =============================================================================
# 以下不在 .env.prod，需手动准备（见 deploy/prod/server-config.example.yaml）
# =============================================================================
# deploy/data/.config.yaml     → manager-api.secret、vision_explain
# deploy/models/SenseVoiceSmall/model.pt → ASR 模型文件
# 智控台参数管理 → aliyun.oss.*、server.voice_print（填 http://voiceprint-api:8005 或公网地址）
# zhiban / voiceprint 地址（同机 Docker 网络）：zhiban-agent:8008、voiceprint-api:8005
