# 仅生产 ACR。复制为 acr.env 后修改（acr.env 勿提交 Git）
# cp acr.env.example acr.env

# 个人版 ACR：从控制台「登录实例」复制完整域名（不要用 registry.cn-beijing.aliyuncs.com）
ACR_REGISTRY=crpi-q9r33h1cqhy6qssk.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=zhiban_agent

# ----- xiaozhi-server -----
SERVER_BASE_TAG=latest
SERVER_APP_TAG=v1.0.0

# ----- xiaozhi-web -----
WEB_RUNTIME_BASE_TAG=latest
WEB_APP_TAG=v1.0.0
