# B 机语音节点：复制为 .env.server-b（勿提交 Git）
# cp .env.server-b.example .env.server-b

# =============================================================================
# 【必填】与 A 机相同的 ACR 镜像 tag（在 A 上 build 后 push，B 只 pull）
# =============================================================================
SERVER_IMAGE=crpi-q9r33h1cqhy6qssk.cn-beijing.personal.cr.aliyuncs.com/zhiban_agent/xiaozhi-server:v1.0.0

# =============================================================================
# 端口（安全组：至少对 A 机 / ALB 放行 8000、8003；不必对公网全开放）
# =============================================================================
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003

# =============================================================================
# 以下不在 compose 环境变量里，请编辑 deploy/data/.config.yaml：
#   manager-api.url  → http://<A内网IP>:8002/xiaozhi
#   manager-api.secret → 与智控台 server.secret 一致
#   vision_explain     → https://api.你的域名/mcp/vision/explain（若经 ALB）
#
# 智控台 server.websocket → wss://api.你的域名/xiaozhi/v1/
# A 机 mqtt.json chat_servers → ws://<B内网IP>:8000/xiaozhi/v1/?from=mqtt_gateway
# =============================================================================
