# 语音节点发版唯一配置（复制为 server.env，可提交 Git，勿写 ACR 密码）
# cp server.env.example server.env
#
# 发版：构建机 bash publish-server.sh [可选新tag]
#      B 机    bash deploy-server.sh

ACR_REGISTRY=crpi-q9r33h1cqhy6qssk.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=zhiban_agent
SERVER_APP_TAG=v1.0.1

SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003

# 可选：一般不用写，脚本会根据上面三项自动生成
# SERVER_IMAGE=
